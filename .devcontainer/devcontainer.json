{
  "name": "Órbita Workspace — navegador no GitHub (sem instalação local)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "bash standalone/orbita-workspace/scripts/setup-codespaces.sh",
  "postStartCommand": "bash standalone/orbita-workspace/scripts/start-codespaces.sh",
  "forwardPorts": [
    6081
  ],
  "portsAttributes": {
    "6081": {
      "label": "Órbita Workspace — interface e perfis remotos",
      "onAutoForward": "notify",
      "visibility": "private",
      "protocol": "http"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": [
        "standalone/orbita-workspace/README.md"
      ]
    }
  },
  "remoteUser": "node"
}
