{
  "manifest_version": 3,
  "name": "SpeedUP GAME",
  "version": "1.4.0",
  "description": "Speed controller via hooks em clocks/timers. Injeta cedo no frame principal e depois em iframes válidos (modo jogos/emuladores).",
  "permissions": ["storage", "scripting", "activeTab", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Speed Hack",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
